  "info": {
    "title": "Wascer Database API",
    "description": "API REST do Database (store) do container sGTM da Wascer. Como começar e guia completo: https://docs.wascer.com/ e https://docs.wascer.com/guia.html",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "https://{host}",
      "variables": {
        "host": {
          "default": "seu-container.soureicdn.com",
          "description": "Host do container sGTM"
        }
      }
    }
  ],
  "components": {
    "schemas": {
      "WascerErrorResponseDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "Código machine-readable do erro",
            "enum": [
              "WASCER_INVALID_REQUEST",
              "WASCER_FORBIDDEN",
              "WASCER_NOT_FOUND",
              "WASCER_CONFLICT",
              "WASCER_PAYLOAD_TOO_LARGE",
              "WASCER_FEATURE_DISABLED",
              "WASCER_FEATURE_PENDING_SCHEMA",
              "WASCER_INTERNAL_ERROR"
            ],
            "example": "WASCER_NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Mensagem legível para humanos",
            "example": "document not found"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "CreateCollectionDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da collection (letras, números, underscore, hífen)",
            "example": "users",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateCollectionResponseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "users"
          }
        },
        "required": [
          "name"
        ]
      },
      "ListCollectionsResponseDto": {
        "type": "object",
        "properties": {
          "collections": {
            "example": [
              "users",
              "orders"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "collections"
        ]
      },
      "CreateDocumentDto": {
        "type": "object",
        "properties": {
          "document_key": {
            "type": "string",
            "description": "Chave única do documento dentro da collection",
            "example": "user-42",
            "minLength": 1,
            "maxLength": 2054
          },
          "data": {
            "type": "object",
            "description": "Payload arbitrário do documento (objeto JSON). Limite total serializado: 500 KB.",
            "additionalProperties": true,
            "example": {
              "name": "Adam",
              "plan": "pro"
            }
          },
          "ttl": {
            "type": "number",
            "description": "TTL custom em segundos. Sobrescreve o default de 90 dias. Omitido ou 0 = default. Máximo 7776000 (90 dias) — o default já é o teto da base. Só na criação.",
            "minimum": 0,
            "maximum": 7776000,
            "example": 1209600
          }
        },
        "required": [
          "document_key",
          "data"
        ]
      },
      "WascerDocumentDto": {
        "type": "object",
        "properties": {
          "document_key": {
            "type": "string",
            "example": "user-42"
          },
          "collection": {
            "type": "string",
            "example": "users"
          },
          "data": {
            "type": "object",
            "additionalProperties": true,
            "example": {
              "name": "Adam",
              "plan": "pro"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-09T12:34:56.789Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-09T12:34:56.789Z"
          }
        },
        "required": [
          "document_key",
          "collection",
          "data",
          "created_at",
          "updated_at"
        ]
      },
      "ListDocumentsResponseDto": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WascerDocumentDto"
            }
          },
          "next_cursor": {
            "type": "object",
            "description": "Cursor para a próxima página (null quando não houver mais)",
            "nullable": true,
            "example": "dXNlci0xMDA="
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "example": "ASC"
          },
          "limit": {
            "type": "number",
            "example": 50
          }
        },
        "required": [
          "documents",
          "next_cursor",
          "order",
          "limit"
        ]
      },
      "UpdateDocumentDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "Novo payload completo do documento (substitui o anterior). Objeto JSON, limite 500 KB.",
            "additionalProperties": true,
            "example": {
              "name": "Adam",
              "plan": "enterprise"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "PatchDocumentDto": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "Atualização parcial — campos enviados sobrescrevem os existentes (merge superficial).",
            "additionalProperties": true,
            "example": {
              "plan": "enterprise"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "QueryDocumentsDto": {
        "type": "object",
        "properties": {
          "filter": {
            "type": "object",
            "description": "Condições sobre campos do `data` (caminho com ponto, ex.: `user_data.email`). Até 10 condições, combinadas por `and` (padrão) ou `or`. Operadores: equal, not-equal, exists, not-exists, contains, not-contains, gt, gte, lt, lte. `exists`/`not-exists` não usam `value`. Sem filtro, retorna todos os documentos da janela.",
            "additionalProperties": true,
            "example": {
              "operator": "and",
              "conditions": [
                {
                  "field": "event_name",
                  "operator": "equal",
                  "value": "purchase"
                },
                {
                  "field": "gclid",
                  "operator": "exists"
                }
              ]
            }
          },
          "created_after": {
            "type": "string",
            "description": "Só documentos criados a partir desta data (ISO 8601).",
            "example": "2026-10-27T00:00:00Z"
          },
          "created_before": {
            "type": "string",
            "description": "Só documentos criados até esta data (ISO 8601).",
            "example": "2026-11-03T23:59:59Z"
          },
          "order": {
            "type": "string",
            "description": "Ordem por data de criação. Padrão: mais recentes primeiro.",
            "enum": [
              "ASC",
              "DESC"
            ],
            "default": "DESC"
          },
          "limit": {
            "type": "number",
            "description": "Máximo de documentos encontrados por resposta.",
            "minimum": 1,
            "maximum": 500,
            "default": 50
          },
          "cursor": {
            "type": "string",
            "description": "`next_cursor` da resposta anterior, para continuar a busca."
          }
        }
      },
      "QueryDocumentsResponseDto": {
        "type": "object",
        "properties": {
          "documents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WascerDocumentDto"
            }
          },
          "next_cursor": {
            "type": "object",
            "description": "Cursor para a próxima página (null quando não houver mais)",
            "nullable": true,
            "example": "dXNlci0xMDA="
          },
          "order": {
            "type": "string",
            "enum": [
              "ASC",
              "DESC"
            ],
            "example": "ASC"
          },
          "limit": {
            "type": "number",
            "example": 50
          },
          "scanned": {
            "type": "number",
            "description": "Documentos lidos nesta chamada (no máximo 1000). Com `next_cursor` não nulo há mais a percorrer, mesmo que `documents` venha vazio.",
            "example": 1000
          }
        },
        "required": [
          "documents",
          "next_cursor",
          "order",
          "limit",
          "scanned"
        ]
      }
    }
  }
}