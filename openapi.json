{
  "openapi": "3.0.0",
  "paths": {
    "/wascer-api/{api_key}/v1/store/collections": {
      "post": {
        "description": "Cria uma nova collection vazia no tenant. Idempotente em relação ao nome.",
        "operationId": "WascerApiController_createCollection",
        "parameters": [
          {
            "name": "api_key",
            "required": true,
            "in": "path",
            "description": "Chave pública (`pk_…`) de uma API key com escopo `database:access`, criada no painel em Configurações → API keys. Vale para os containers do dono da chave.",
            "schema": {
              "example": "pk_0123456789abcdef"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCollectionDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCollectionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida (corpo, filtro, cursor ou nome)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_INVALID_REQUEST",
                  "message": "collection_name must match ^[a-zA-Z0-9_-]{1,64}$"
                }
              }
            }
          },
          "403": {
            "description": "Chave errada, revogada ou sem o escopo database:access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FORBIDDEN",
                  "message": "invalid api key"
                }
              }
            }
          },
          "503": {
            "description": "API ainda não ativa no container (crie a chave e aguarde até 2 min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FEATURE_DISABLED",
                  "message": "Feature enable_wascer_api is disabled"
                }
              }
            }
          }
        },
        "summary": "Criar collection",
        "tags": [
          "Wascer API — Collections & Documents"
        ]
      },
      "get": {
        "description": "Retorna todas as collections do tenant.",
        "operationId": "WascerApiController_listCollections",
        "parameters": [
          {
            "name": "api_key",
            "required": true,
            "in": "path",
            "description": "Chave pública (`pk_…`) de uma API key com escopo `database:access`, criada no painel em Configurações → API keys. Vale para os containers do dono da chave.",
            "schema": {
              "example": "pk_0123456789abcdef"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCollectionsResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Chave errada, revogada ou sem o escopo database:access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FORBIDDEN",
                  "message": "invalid api key"
                }
              }
            }
          },
          "503": {
            "description": "API ainda não ativa no container (crie a chave e aguarde até 2 min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FEATURE_DISABLED",
                  "message": "Feature enable_wascer_api is disabled"
                }
              }
            }
          }
        },
        "summary": "Listar collections",
        "tags": [
          "Wascer API — Collections & Documents"
        ]
      }
    },
    "/wascer-api/{api_key}/v1/store/collections/{collection_name}/documents": {
      "post": {
        "description": "Cria um documento na collection. Falha com 409 se `document_key` já existir.",
        "operationId": "WascerApiController_createDocument",
        "parameters": [
          {
            "name": "collection_name",
            "required": true,
            "in": "path",
            "schema": {
              "example": "users",
              "type": "string"
            }
          },
          {
            "name": "api_key",
            "required": true,
            "in": "path",
            "description": "Chave pública (`pk_…`) de uma API key com escopo `database:access`, criada no painel em Configurações → API keys. Vale para os containers do dono da chave.",
            "schema": {
              "example": "pk_0123456789abcdef"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDocumentDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerDocumentDto"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida (corpo, filtro, cursor ou nome)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_INVALID_REQUEST",
                  "message": "collection_name must match ^[a-zA-Z0-9_-]{1,64}$"
                }
              }
            }
          },
          "403": {
            "description": "Chave errada, revogada ou sem o escopo database:access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FORBIDDEN",
                  "message": "invalid api key"
                }
              }
            }
          },
          "409": {
            "description": "document_key já existe nesta collection",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_CONFLICT",
                  "message": "document already exists"
                }
              }
            }
          },
          "413": {
            "description": "data acima de 500 KB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_PAYLOAD_TOO_LARGE",
                  "message": "payload exceeds size limit"
                }
              }
            }
          },
          "503": {
            "description": "API ainda não ativa no container (crie a chave e aguarde até 2 min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FEATURE_DISABLED",
                  "message": "Feature enable_wascer_api is disabled"
                }
              }
            }
          }
        },
        "summary": "Criar documento",
        "tags": [
          "Wascer API — Collections & Documents"
        ]
      },
      "get": {
        "description": "Lista documentos da collection com paginação por cursor. Use `next_cursor` para a próxima página.",
        "operationId": "WascerApiController_listDocuments",
        "parameters": [
          {
            "name": "collection_name",
            "required": true,
            "in": "path",
            "schema": {
              "example": "users",
              "type": "string"
            }
          },
          {
            "name": "order",
            "required": false,
            "in": "query",
            "description": "Ordem da listagem por document_key",
            "schema": {
              "default": "ASC",
              "type": "string",
              "enum": [
                "ASC",
                "DESC"
              ]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Quantidade máxima de documentos retornados",
            "schema": {
              "minimum": 1,
              "maximum": 500,
              "default": 50,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Cursor opaco (base64) retornado em `next_cursor` para paginação subsequente",
            "schema": {
              "example": "dXNlci00Mg==",
              "type": "string"
            }
          },
          {
            "name": "api_key",
            "required": true,
            "in": "path",
            "description": "Chave pública (`pk_…`) de uma API key com escopo `database:access`, criada no painel em Configurações → API keys. Vale para os containers do dono da chave.",
            "schema": {
              "example": "pk_0123456789abcdef"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListDocumentsResponseDto"
                }
              }
            }
          },
          "403": {
            "description": "Chave errada, revogada ou sem o escopo database:access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FORBIDDEN",
                  "message": "invalid api key"
                }
              }
            }
          },
          "503": {
            "description": "API ainda não ativa no container (crie a chave e aguarde até 2 min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FEATURE_DISABLED",
                  "message": "Feature enable_wascer_api is disabled"
                }
              }
            }
          }
        },
        "summary": "Listar documentos",
        "tags": [
          "Wascer API — Collections & Documents"
        ]
      }
    },
    "/wascer-api/{api_key}/v1/store/collections/{collection_name}/documents/query": {
      "post": {
        "description": "**Em breve.** Esta rota já foi feita e está sendo liberada aos poucos nos containers. Enquanto não chegar no seu, ela responde erro (a requisição cai no sGTM): use a listagem (`GET …/documents?order=DESC`) e filtre do seu lado.\n\nFiltra a collection por campos do `data`, do mais recente para o mais antigo. Cada chamada lê no máximo 1000 documentos; enquanto `next_cursor` não for nulo, chame de novo com ele para continuar. Use `created_after`/`created_before` para limitar a janela.",
        "operationId": "WascerApiController_queryDocuments",
        "parameters": [
          {
            "name": "collection_name",
            "required": true,
            "in": "path",
            "schema": {
              "example": "purchases",
              "type": "string"
            }
          },
          {
            "name": "api_key",
            "required": true,
            "in": "path",
            "description": "Chave pública (`pk_…`) de uma API key com escopo `database:access`, criada no painel em Configurações → API keys. Vale para os containers do dono da chave.",
            "schema": {
              "example": "pk_0123456789abcdef"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryDocumentsDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryDocumentsResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Requisição inválida (corpo, filtro, cursor ou nome)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_INVALID_REQUEST",
                  "message": "collection_name must match ^[a-zA-Z0-9_-]{1,64}$"
                }
              }
            }
          },
          "403": {
            "description": "Chave errada, revogada ou sem o escopo database:access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FORBIDDEN",
                  "message": "invalid api key"
                }
              }
            }
          },
          "503": {
            "description": "API ainda não ativa no container (crie a chave e aguarde até 2 min)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WascerErrorResponseDto"
                },
                "example": {
                  "code": "WASCER_FEATURE_DISABLED",
                  "message": "Feature enable_wascer_api is disabled"
                }
              }
            }
          }
        },
        "summary": "Em breve: buscar documentos por campo",
        "tags": [
          "Wascer API — Collections & Documents"
        ],
        "deprecated": true
      }
    },
